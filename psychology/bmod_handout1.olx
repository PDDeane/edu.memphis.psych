              placeholder="The antecedent I am changing is..." />

    <Markdown id="bmod_h1_q6_change_a1_label">**How will you change it?**</Markdown>
    <TextArea id="bmod_h1_q6_change_a1" rows="3"
              placeholder="I will change it by..." />

    <Markdown id="bmod_h1_q6_state_c1_label">**Which consequence from 4c will that affect?**</Markdown>
    <TextArea id="bmod_h1_q6_state_c1" rows="2"
              placeholder="The consequence this affects is..." />

    <Markdown id="bmod_h1_q6_affect_c1_label">**How will it be affected?**</Markdown>
    <TextArea id="bmod_h1_q6_affect_c1" rows="3"
              placeholder="That consequence will change because..." />

    <Markdown id="bmod_h1_q6_a2_head">### Your second antecedent</Markdown>

    <Markdown id="bmod_h1_q6_state_a2_label">**Which other antecedent from 4a are you changing?**</Markdown>
    <TextArea id="bmod_h1_q6_state_a2" rows="2"
              placeholder="The other antecedent I am changing is..." />

    <Markdown id="bmod_h1_q6_change_a2_label">**How will you change it?**</Markdown>
    <TextArea id="bmod_h1_q6_change_a2" rows="3"
              placeholder="I will change it by..." />

    <Markdown id="bmod_h1_q6_state_c2_label">**Which other consequence from 4c will that affect?**</Markdown>
    <TextArea id="bmod_h1_q6_state_c2" rows="2"
              placeholder="The other consequence this affects is..." />

    <Markdown id="bmod_h1_q6_affect_c2_label">**How will it be affected?**</Markdown>
    <TextArea id="bmod_h1_q6_affect_c2" rows="3"
              placeholder="That consequence will change because..." />

    <LLMFeedback id="bmod_h1_q6_feedback" />
